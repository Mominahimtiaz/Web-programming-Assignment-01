/* Page background */

body{
    background:#bfbfbf;
    margin:0;
    font-family: Arial, Helvetica, sans-serif;
}

/* Main card container */

.card{
    max-width:650px;      /* smaller so it fits screen */
    margin:40px auto;
    background:#efefef;
    padding:35px 45px;
    border-radius:20px;
}

/* Main heading */

h1{
    font-family:'Oswald', sans-serif;
    font-size:70px;       /* reduced size */
    color:#3f8f13;
    text-align:center;
    margin:0 0 20px 0;
}

/* Section headings */

h2{
    font-family:'Oswald', sans-serif;
    font-size:32px;       /* reduced size */
    color:#3f8f13;
    text-align:center;
    margin-top:35px;
}

/* Paragraph text */

p{
    font-size:15px;
    line-height:1.6;
    color:#333;
}

/* Green info box */

.fact{
    background:#4aa31a;
    color:white;
    padding:20px;
    border-radius:18px;
    margin:25px 0;
}

.fact h3{
    font-family:'Oswald', sans-serif;
    font-size:22px;
    margin-top:0;
}

.fact p{
    color:white;
}
